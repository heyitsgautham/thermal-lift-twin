# Copy to .env at the repository root for `docker compose`, which reads it for
# the variables below. Every value is optional.

# Display names baked into the web image at build time.
# Same meaning as in apps/web/.env.example.
NEXT_PUBLIC_PRODUCT=
NEXT_PUBLIC_FIELD=
NEXT_PUBLIC_EVENT=
NEXT_PUBLIC_PS=

# Log level for the API and the web server: DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO

# Sentry error tracking for the API. Leave empty to send nothing.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# The tools below read these from the shell, not from this file, so export them
# or prefix a command with them. A blank value keeps the default.

# API: folder with field.json, tables.json and daily.parquet.
# Defaults to data/demo in the repository. The API image sets /app/data/demo.
BGW_DATA_DIR=

# next.config.ts: "standalone" ships a self-contained server. apps/web/Dockerfile
# sets it. Leave it blank locally.
NEXT_OUTPUT=

# Recording scripts: the app they drive, default http://localhost:3000
# (http://localhost:3101 for the story takes), and the sizes `pnpm shots` captures.
BASE_URL=
VIEWPORTS=1920x1080,1440x900

# `pnpm check:names`: more words to block from tracked files, separated by "|".
PRIVATE_TERMS=
