# Copy to .env at the repository root for `docker compose`, which reads it for
# the variables below. Every value is optional.

# Display names baked into the web image at build time.
# Same meaning as in apps/web/.env.example.
NEXT_PUBLIC_PRODUCT=
NEXT_PUBLIC_FIELD=
NEXT_PUBLIC_EVENT=
NEXT_PUBLIC_PS=

# Log level for the API and the web server: DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO

# Sentry error tracking for the API. Leave empty to send nothing.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# The variables below are read from the shell, not from this file.
#
# BGW_DATA_DIR   folder with field.json, tables.json and daily.parquet for the API.
#                Defaults to data/demo in the repository. The API image sets /app/data/demo.
# NEXT_OUTPUT    set to "standalone" by apps/web/Dockerfile. Leave it unset locally.
# BASE_URL       app the recording scripts drive, default http://localhost:3000.
# VIEWPORTS      sizes `pnpm shots` captures, default 1920x1080,1440x900.
