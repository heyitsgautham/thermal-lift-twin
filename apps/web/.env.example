# Copy to apps/web/.env.local, which git ignores. Every value is optional.
# Next.js reads it for `pnpm dev` and `pnpm build`.

# Display names the public repository leaves out.
# Empty values show the neutral names: "Thermal Lift Twin" and "the field".
NEXT_PUBLIC_PRODUCT=
NEXT_PUBLIC_FIELD=
NEXT_PUBLIC_EVENT=
NEXT_PUBLIC_PS=

# More words `pnpm check:names` and the pre-commit hook block from tracked files, separated by "|".
# The check also blocks the FIELD, EVENT and PS values above.
PRIVATE_TERMS=
